@model TravelHubOTA.Models.Hotel

@{
    ViewData["Title"] = Model.Name;
}

<div class="container py-5">

    <div class="mb-4">

        <a asp-controller="Home"
           asp-action="Index"
           class="text-decoration-none">

            ← Back to Hotels

        </a>

    </div>


    <div class="row g-5">

        <!-- HOTEL IMAGE -->

        <div class="col-lg-7">

            <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80"
                 class="img-fluid rounded-4 shadow-sm w-100"
                 style="height: 430px; object-fit: cover;"
                 alt="@Model.Name" />

        </div>


        <!-- HOTEL INFORMATION -->

        <div class="col-lg-5">

            <span class="badge bg-primary-subtle text-primary mb-3">
                HOTEL
            </span>

            <h1 class="fw-bold">
                @Model.Name
            </h1>

            <p class="text-muted fs-5">
                📍 @Model.City, @Model.Country
            </p>


            <div class="mb-4">

                <span class="text-warning fs-5">
                    ★★★★★
                </span>

                <span class="text-muted ms-2">
                    Highly rated property
                </span>

            </div>


            <hr />


            <div class="row g-4 my-3">

                <div class="col-6">

                    <small class="text-muted">
                        Starting from
                    </small>

                    <div class="fs-2 fw-bold">
                        $@Model.PricePerNight
                    </div>

                    <small class="text-muted">
                        per night
                    </small>

                </div>


                <div class="col-6">

                    <small class="text-muted">
                        Availability
                    </small>

                    <div class="fs-2 fw-bold text-success">
                        @Model.RoomsAvailable
                    </div>

                    <small class="text-muted">
                        rooms available
                    </small>

                </div>

            </div>


            @if (Model.RoomsAvailable > 0)
            {

                <a asp-controller="Booking"
                   asp-action="Create"
                   asp-route-hotelId="@Model.Id"
                   class="btn btn-primary btn-lg w-100">

                    Book This Hotel

                </a>

            }
            else
            {

                <button class="btn btn-secondary btn-lg w-100"
                        disabled>

                    Sold Out

                </button>

            }

        </div>

    </div>

</div>