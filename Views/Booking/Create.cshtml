@model TravelHubOTA.Models.Booking

@{
    ViewData["Title"] = "Create Booking";

    var hotel =
        ViewBag.Hotel as TravelHubOTA.Models.Hotel;
}

<div class="container py-5">

    <div class="mb-4">

        <a asp-controller="Hotel"
           asp-action="Details"
           asp-route-id="@hotel?.Id"
           class="text-decoration-none">

            ← Back to Hotel

        </a>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4 p-lg-5">

                    <div class="mb-4">

                        <span class="badge bg-primary-subtle text-primary mb-2">
                            NEW BOOKING
                        </span>

                        <h2 class="fw-bold">
                            Book @hotel?.Name
                        </h2>

                        <p class="text-muted">
                            @hotel?.City, @hotel?.Country
                            · $@hotel?.PricePerNight per night
                        </p>

                    </div>


                    <div class="alert alert-light border">

                        <strong>
                            @hotel?.RoomsAvailable rooms
                        </strong>

                        currently available.

                    </div>


                    <form asp-action="Create"
                          method="post">

                        <input type="hidden"
                               asp-for="HotelId" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>


                        <div class="mb-4">

                            <label asp-for="GuestName"
                                   class="form-label fw-semibold">

                                Guest Name

                            </label>

                            <input asp-for="GuestName"
                                   class="form-control form-control-lg"
                                   placeholder="Enter guest full name" />

                            <span asp-validation-for="GuestName"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="row g-4">

                            <div class="col-md-6">

                                <label asp-for="CheckIn"
                                       class="form-label fw-semibold">

                                    Check In

                                </label>

                                <input asp-for="CheckIn"
                                       type="date"
                                       class="form-control form-control-lg" />

                                <span asp-validation-for="CheckIn"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="CheckOut"
                                       class="form-label fw-semibold">

                                    Check Out

                                </label>

                                <input asp-for="CheckOut"
                                       type="date"
                                       class="form-control form-control-lg" />

                                <span asp-validation-for="CheckOut"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <div class="mt-4 mb-4">

                            <label asp-for="Rooms"
                                   class="form-label fw-semibold">

                                Number of Rooms

                            </label>

                            <input asp-for="Rooms"
                                   type="number"
                                   min="1"
                                   max="@hotel?.RoomsAvailable"
                                   class="form-control form-control-lg" />

                            <span asp-validation-for="Rooms"
                                  class="text-danger">
                            </span>

                        </div>


                        <hr class="my-4" />


                        <div class="d-flex justify-content-between align-items-center mb-4">

                            <span class="text-muted">
                                Final price
                            </span>

                            <span class="text-muted">
                                Calculated after selecting dates
                            </span>

                        </div>


                        <button type="submit"
                                class="btn btn-primary btn-lg w-100">

                            Confirm Booking

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}