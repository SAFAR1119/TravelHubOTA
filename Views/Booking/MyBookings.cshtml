@model List<TravelHubOTA.Models.Booking>

@{
    ViewData["Title"] = "My Bookings";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="fw-bold mb-1">
            My Bookings
        </h1>

        <p class="text-muted mb-0">
            Manage your agency's hotel bookings.
        </p>
    </div>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-primary">
        + New Booking
    </a>

</div>


@if (Model.Count == 0)
{
    <div class="card shadow-sm">

        <div class="card-body text-center py-5">

            <div class="display-4 mb-3">
                🏨
            </div>

            <h4>
                No bookings yet
            </h4>

            <p class="text-muted">
                Start by searching for a hotel.
            </p>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-primary">
                Search Hotels
            </a>

        </div>

    </div>
}
else
{
    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>
                            <th>Reference</th>
                            <th>Guest</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                            <th>Rooms</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th></th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var booking in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        #TH-@booking.Id.ToString("D5")
                                    </strong>
                                </td>

                                <td>
                                    @booking.GuestName
                                </td>

                                <td>
                                    @booking.CheckIn.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @booking.CheckOut.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @booking.Rooms
                                </td>

                                <td>
                                    $@booking.TotalPrice
                                </td>

                                <td>

                                    @if (booking.Status == "Confirmed")
                                    {
                                        <span class="badge bg-success">
                                            Confirmed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Cancelled
                                        </span>
                                    }

                                </td>

                                <td>

                                    <a asp-controller="Booking"
                                       asp-action="Details"
                                       asp-route-id="@booking.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
}