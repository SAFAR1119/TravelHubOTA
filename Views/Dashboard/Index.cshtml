@{
    ViewData["Title"] = "Dashboard";

    var agency =
        ViewBag.Agency as TravelHubOTA.Models.Agency;

    var bookings =
        ViewBag.Bookings as List<TravelHubOTA.Models.Booking>
        ?? new List<TravelHubOTA.Models.Booking>();
}

<div class="container py-5">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-5">

        <div>

            <p class="text-primary fw-semibold mb-1">
                AGENCY PORTAL
            </p>

            <h1 class="fw-bold mb-1">
                Welcome back
            </h1>

            <p class="text-muted mb-0">
                @agency?.Name
            </p>

        </div>


        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-primary">

            + New Booking

        </a>

    </div>


    <!-- STATS -->

    <div class="row g-4 mb-5">

        <div class="col-md-4">

            <div class="stat-card">

                <div class="stat-label">
                    Total Bookings
                </div>

                <div class="stat-value">
                    @bookings.Count
                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="stat-card">

                <div class="stat-label">
                    Confirmed Bookings
                </div>

                <div class="stat-value text-success">
                    @bookings.Count(b =>
                        b.Status == "Confirmed")
                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="stat-card">

                <div class="stat-label">
                   Total Booking Value
                </div>

                <div class="stat-value">
                    $@Convert.ToDecimal(ViewBag.TotalBookingValue).ToString("N2")
                </div>

            </div>

        </div>

    </div>


    <!-- BOOKINGS -->

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h4 class="fw-bold mb-1">
                        Recent Bookings
                    </h4>

                    <p class="text-muted mb-0">
                        Your latest reservations.
                    </p>

                </div>

                <a asp-controller="Booking"
                   asp-action="MyBookings"
                   class="btn btn-outline-primary">

                    View All

                </a>

            </div>


            @if (bookings.Count == 0)
            {
                <div class="text-center py-5">

                    <h5>
                        No bookings yet
                    </h5>

                    <p class="text-muted">
                        Start by searching for a hotel.
                    </p>

                </div>
            }
            else
            {

                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>

                            <tr>

                                <th>Reference</th>
                                <th>Guest</th>
                                <th>Check In</th>
                                <th>Check Out</th>
                                <th>Rooms</th>
                                <th>Total</th>
                                <th>Status</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var booking in bookings.Take(5))
                            {

                                <tr>

                                    <td>

                                        <a asp-controller="Booking"
                                           asp-action="Details"
                                           asp-route-id="@booking.Id"
                                           class="fw-semibold text-decoration-none">

                                            #TH-@booking.Id.ToString("D5")

                                        </a>

                                    </td>


                                    <td>
                                        @booking.GuestName
                                    </td>


                                    <td>
                                        @booking.CheckIn.ToString("dd MMM yyyy")
                                    </td>


                                    <td>
                                        @booking.CheckOut.ToString("dd MMM yyyy")
                                    </td>


                                    <td>
                                        @booking.Rooms
                                    </td>


                                    <td>
                                        $@booking.TotalPrice
                                    </td>


                                    <td>

                                        @if (booking.Status == "Confirmed")
                                        {
                                            <span class="badge bg-success">
                                                Confirmed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }

        </div>

    </div>

</div>