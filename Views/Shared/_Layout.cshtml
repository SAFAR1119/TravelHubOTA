<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TravelHub OTA</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">
        <div class="container">

            <a class="navbar-brand fw-bold"
               asp-controller="Home"
               asp-action="Index">
                ✈️ TravelHub OTA
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbar">

                <ul class="navbar-nav ms-auto">

                 <li class="nav-item">
                     <a class="nav-link"
                         asp-controller="Home"
                         asp-action="Index">
                         Hotels
                       </a>
                  </li>

                 @if (Context.Session.GetInt32("AgencyId") != null)
                  {
                   <li class="nav-item">
                     <a class="nav-link"
                         asp-controller="Dashboard"
                         asp-action="Index">
                        Dashboard
                     </a>
                   </li>

                   <li class="nav-item">
                      <a class="nav-link"
                         asp-controller="Booking"
                         asp-action="MyBookings">
                         My Bookings
                      </a>
                   </li>

                   <li class="nav-item">
                     <a class="nav-link"
                     asp-controller="Account"
                     asp-action="Logout">
                      Logout
                    </a>
                   </li>
                  }
                  else
                  {
                  <li class="nav-item">
                      <a class="nav-link"
                      asp-controller="Account"
                       asp-action="Login">
                     Login
                      </a>
                 </li>
                   }

                </ul>

            </div>

        </div>
    </nav>

    <!-- Page Content -->
    <main class="container mt-4">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="border-top mt-5 py-4 text-center text-muted">
        &copy; @DateTime.Now.Year - TravelHub OTA
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>