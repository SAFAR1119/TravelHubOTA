@model List<TravelHubOTA.Models.Hotel>

@{
ViewData["Title"] = "TravelHub OTA";
}

<!-- Hero / Search Section -->

<div class="bg-primary text-white rounded-4 p-5 mb-5">

<div class="text-center">

    <h1 class="display-5 fw-bold">
        Find Hotels for Your Clients
    </h1>

    <p class="lead">
        Search and book hotels with TravelHub OTA.
    </p>

</div>

<form method="get"
      asp-controller="Home"
      asp-action="Index"
      class="mt-4">

    <div class="row g-2">

        <div class="col-md-9">

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control form-control-lg"
                   placeholder="Search by hotel, city or country..." />

        </div>

        <div class="col-md-3">

            <button type="submit"
                    class="btn btn-light btn-lg w-100">
                🔍 Search
            </button>

        </div>

    </div>

</form>

</div>

<!-- Hotel Results Header -->

<div class="d-flex justify-content-between align-items-center mb-4">

<h2>Available Hotels</h2>

<span class="text-muted">
    @Model.Count hotel(s) found
</span>

</div>

<!-- Hotel Results -->

@if (Model.Count == 0)
{ <div class="alert alert-warning text-center py-4">

    <h4>No hotels found</h4>

    <p class="mb-0">
        Try searching for another hotel, city or country.
    </p>

</div>

}
else
{ <div class="row">

    @foreach (var hotel in Model)
    {
        <div class="col-lg-4 col-md-6 mb-4">

            <div class="card shadow-sm h-100">

                <!-- Hotel Image -->
                <img src="~/images/hotels/@hotel.Image"
                     class="card-img-top"
                     style="height:220px;object-fit:cover;"
                     alt="@hotel.Name">


                <div class="card-body d-flex flex-column">

                    <!-- Hotel Name -->
                    <h4 class="card-title">
                        @hotel.Name
                    </h4>


                    <!-- Location -->
                    <p class="text-muted mb-2">
                        📍 @hotel.City, @hotel.Country
                    </p>


                    <!-- Star Rating -->
                    <p class="mb-2">

                        @for (int i = 0; i < hotel.Stars; i++)
                        {
                            <span class="text-warning">★</span>
                        }

                    </p>


                    <!-- Price -->
                    <h5 class="text-success">
                        $@hotel.PricePerNight
                        <small class="text-muted">
                            /night
                        </small>
                    </h5>


                    <!-- Available Rooms -->
                    <p class="text-muted">
                        @hotel.RoomsAvailable rooms available
                    </p>


                    <!-- Facilities -->
                    <div class="mb-3">

                        @foreach (var facility in hotel.Facilities)
                        {
                            <span class="badge bg-light text-dark me-1 mb-1">
                                @facility
                            </span>
                        }

                    </div>


                    <!-- View Hotel Button -->
                    <a asp-controller="Hotel"
                      asp-action="Details"
                      asp-route-id="@hotel.Id"
                      class="btn btn-primary w-100 mt-auto">
                        View Hotel
                   </a>

                </div>

            </div>

        </div>
    }

</div>

}
