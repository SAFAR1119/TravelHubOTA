@model List<TravelHubOTA.Models.Hotel>

@{
    ViewData["Title"] = "Hotels";
}

<!-- HERO -->

<section class="hero">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-7">

                <span class="badge bg-light text-primary mb-3">
                    B2B HOTEL BOOKING
                </span>

                <h1>
                    Book hotels for your clients
                    with confidence.
                </h1>

                <p class="lead mt-3 mb-4">

                    Access hotel inventory,
                    manage bookings and
                    serve your travelers from one platform.

                </p>

            </div>

        </div>


        <!-- SEARCH -->

        <div class="search-box">

            <form asp-controller="Home"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-lg-9">

                        <label class="form-label text-dark">
                            Destination or Hotel
                        </label>

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control form-control-lg"
                               placeholder="Search city, country or hotel..." />

                    </div>


                    <div class="col-lg-3">

                        <button type="submit"
                                class="btn btn-primary btn-lg w-100">

                            Search Hotels

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

</section>


<!-- HOTEL LIST -->

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Available Hotels
            </h2>

            <p class="text-muted mb-0">
                Select a property to view rates and availability.
            </p>

        </div>

        <span class="text-muted">
            @Model.Count properties
        </span>

    </div>


    @if (Model.Count == 0)
    {
        <div class="card shadow-sm">

            <div class="card-body text-center py-5">

                <h4>
                    No hotels found
                </h4>

                <p class="text-muted">
                    Try searching for another destination.
                </p>

            </div>

        </div>
    }
    else
    {

        <div class="row g-4">

            @foreach (var hotel in Model)
            {

                <div class="col-md-6 col-lg-4">

                    <div class="card hotel-card h-100 shadow-sm">

                        <!-- Image -->

                        <div class="position-relative">

                            <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=900&q=80"
                                 class="card-img-top hotel-image"
                                 alt="@hotel.Name" />

                            @if (hotel.RoomsAvailable > 0)
                            {
                                <span class="badge bg-success position-absolute top-0 end-0 m-3">
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger position-absolute top-0 end-0 m-3">
                                    Sold Out
                                </span>
                            }

                        </div>


                        <!-- Content -->

                        <div class="card-body d-flex flex-column">

                            <div class="mb-2">

                                <span class="text-warning">
                                    ★★★★★
                                </span>

                            </div>

                            <h5 class="card-title fw-bold">
                                @hotel.Name
                            </h5>

                            <p class="text-muted mb-3">

                                📍 @hotel.City,
                                @hotel.Country

                            </p>


                            <div class="mt-auto">

                                <div class="d-flex justify-content-between align-items-end mb-3">

                                    <div>

                                        <small class="text-muted">
                                            From
                                        </small>

                                        <div class="fs-4 fw-bold">
                                            $@hotel.PricePerNight
                                        </div>

                                        <small class="text-muted">
                                            per night
                                        </small>

                                    </div>


                                    <div class="text-end">

                                        <small class="text-muted">
                                            Rooms
                                        </small>

                                        <div class="fw-semibold">
                                            @hotel.RoomsAvailable
                                        </div>

                                    </div>

                                </div>


                                <a asp-controller="Hotel"
                                   asp-action="Details"
                                   asp-route-id="@hotel.Id"
                                   class="btn btn-primary w-100">

                                    View Hotel

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            }

        </div>

    }

</div>